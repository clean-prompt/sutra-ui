{
  "name": "sutra",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm --filter @sutra/ui build",
    "dev": "pnpm --filter @sutra/ui dev",
    "playground": "pnpm --filter playground dev",
    "typecheck": "pnpm -r typecheck",
    "audit:all": "pnpm --filter playground audit:all",
    "docs:gen": "node packages/ui/scripts/gen-docs.mjs",
    "docs:llms": "node packages/ui/scripts/gen-llms.mjs",
    "docs:check": "node packages/ui/scripts/gen-docs.mjs --check && node packages/ui/scripts/gen-llms.mjs --check",
    "docs:baseline": "node packages/ui/scripts/gen-docs.mjs --update-baseline",
    "verify": "pnpm --filter @sutra/ui verify && pnpm --filter playground typecheck && pnpm --filter playground build"
  }
}
