    "./voice": {
      "types": "./dist/entries/voice.d.ts",
      "import": "./dist/entries/voice.js"
    },
    "./social": {
      "types": "./dist/entries/social.d.ts",
      "import": "./dist/entries/social.js"
    },
    "./blocks": {
      "types": "./dist/entries/blocks.d.ts",
      "import": "./dist/entries/blocks.js"
    },
    "./assets": {
      "types": "./dist/entries/assets.d.ts",
      "import": "./dist/entries/assets.js"
