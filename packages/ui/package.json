    "./overlays": {
      "types": "./dist/entries/overlays.d.ts",
      "import": "./dist/entries/overlays.js"
    },
    "./navigation": {
      "types": "./dist/entries/navigation.d.ts",
      "import": "./dist/entries/navigation.js"
    },
    "./tokens": {
      "types": "./dist/entries/tokens.d.ts",
      "import": "./dist/entries/tokens.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./blocks/*": {
      "types": "./dist/blocks/*.d.ts",
      "import": "./dist/blocks/*.js"
    },
    "./assets/*": {
      "types": "./dist/assets/*.d.ts",
      "import": "./dist/assets/*.js"
    },
    "./styles.css": "./src/styles/sutra.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
