  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/entries/icons.d.ts",
      "import": "./dist/entries/icons.js"
    },
    "./ai": {
      "types": "./dist/entries/ai.d.ts",
      "import": "./dist/entries/ai.js"
    },
    "./suite": {
      "types": "./dist/entries/suite.d.ts",
