/** Pure helpers for `WheelPicker`: which row is centred, where the keys and type-ahead land, and range building. */

/** The row that sits in the centre of a scroll-snapped wheel (`scrollTop` 0 centres row 0), clamped to the list. */
export function snapIndex(scrollTop: number, itemHeight: number, count: number): number {
  if (count <= 0 || itemHeight <= 0) return 0;
  return Math.min(count - 1, Math.max(0, Math.round(scrollTop / itemHeight)));
}

/** The `scrollTop` that centres a row. */
export function scrollTopFor(index: number, itemHeight: number): number {
  return Math.max(0, index) * itemHeight;
}

/** The enabled row closest to `index` (the row itself when enabled, the lower one on a tie); `-1` when every row is disabled. */
export function nearestEnabled(disabled: readonly boolean[], index: number): number {
  const at = Math.min(disabled.length - 1, Math.max(0, index));
  for (let d = 0; d < disabled.length; d++) {
    if (at - d >= 0 && !disabled[at - d]) return at - d;
    if (at + d < disabled.length && !disabled[at + d]) return at + d;
  }
  return -1;
}

/** Move `steps` enabled rows from `from` (negative is up), stopping at the first or last enabled row; no wrapping. */
export function stepEnabled(disabled: readonly boolean[], from: number, steps: number): number {
  const dir = steps < 0 ? -1 : 1;
  let at = from;
  for (let left = Math.abs(steps); left > 0; left--) {
    let next = at + dir;
    while (next >= 0 && next < disabled.length && disabled[next]) next += dir;
    if (next < 0 || next >= disabled.length) break;
    at = next;
  }
  return at;
}

/** The first (`"first"`) or last enabled row, `-1` when none. */
export function edgeEnabled(disabled: readonly boolean[], edge: "first" | "last"): number {
  if (edge === "first") return disabled.findIndex((d) => !d);
  for (let i = disabled.length - 1; i >= 0; i--) if (!disabled[i]) return i;
  return -1;
}

/**
 * Type-ahead: the enabled row whose text starts with `query` (case-insensitive). The search begins after `from`, so the
 * same letter typed again cycles through the rows that share it; a longer query may keep the current row. `-1` for no match.
 */
export function typeAheadIndex(texts: readonly string[], disabled: readonly boolean[], query: string, from: number): number {
  const q = query.toLowerCase();
  if (!q) return -1;
  const cycle = [...q].every((c) => c === q[0]);
  const start = cycle ? from + 1 : Math.max(0, from);
  for (let i = 0; i < texts.length; i++) {
    const at = (start + i) % texts.length;
    if (!disabled[at] && texts[at]!.toLowerCase().startsWith(cycle ? q[0]! : q)) return at;
  }
  return -1;
}

export interface WheelRangeOptions {
  /** Step between values. Default 1. */
  step?: number;
  /** Zero-pad to this many digits (`2` gives `"05"`). */
  pad?: number;
}

/** Numeric option values from `start` to `end` inclusive: `wheelRange(0, 59, { pad: 2 })` is `"00" … "59"`. */
export function wheelRange(start: number, end: number, { step = 1, pad = 0 }: WheelRangeOptions = {}): string[] {
  const out: string[] = [];
  if (!(step > 0)) return out;
  for (let n = start; n <= end; n += step) out.push(String(n).padStart(pad, "0"));
  return out;
}
